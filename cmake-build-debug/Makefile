src/views/monitor.cc.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/NezhaGuard.dir/build.make CMakeFiles/NezhaGuard.dir/src/views/monitor.cc.i
.PHONY : src/views/monitor.cc.i

src/views/monitor.s: src/views/monitor.cc.s
.PHONY : src/views/monitor.s

# target to generate assembly for a file
src/views/monitor.cc.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/NezhaGuard.dir/build.make CMakeFiles/NezhaGuard.dir/src/views/monitor.cc.s
.PHONY : src/views/monitor.cc.s

